{
  "name": "@dinder/backend",
  "version": "1.0.0",
  "description": "Dinder backend server with Express and Socket.IO",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest --no-file-parallelism",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "compare:smoke": "tsx scripts/compare-smoke.ts",
    "grocery:smoke": "tsx scripts/grocery-smoke.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@dinder/shared": "file:../shared",
    "@supabase/supabase-js": "^2.86.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "0.35.4",
    "socket.io": "^4.7.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis-mock": "^8.2.7",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "~8.39.0",
    "@typescript-eslint/parser": "~8.39.0",
    "eslint": "^8.56.0",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.1.1",
    "socket.io-client": "^4.7.2",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "~4.1.11"
  },
  "keywords": [
    "dinder",
    "dinner",
    "websocket",
    "redis"
  ],
  "author": "Dinder Team",
  "license": "MIT"
}
