  "causalSequence": [
    "peel, deseed pumpkin; cut 3-4 cm pieces",
    "soften onion, garlic in olive oil over medium heat ~3 min",
    "add pumpkin, stock; boil then simmer uncovered 20-30 min until very tender",
    "cool slightly; blend smooth with stick blender",
    "stir in cream; season; reheat gently without boiling",
    "serve with cream swirl, chives, black pepper"
