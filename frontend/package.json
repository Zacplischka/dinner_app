{
  "name": "@dinder/frontend",
  "version": "1.0.0",
  "description": "Dinder frontend with React and Vite",
  "type": "module",
  "scripts": {
    "mobile:sync": "node scripts/mobile.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:live": "set -a && . ../backend/.env && set +a && VITE_API_BASE_URL=http://localhost:3001/api VITE_BACKEND_URL=http://localhost:3001 BASE_URL=http://localhost:3000 BACKEND_URL=http://localhost:3001 RUN_LIVE_COMPARE=1 playwright test --project=mobile-chrome compare-live.spec.ts",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/ios": "8.5.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@dinder/shared": "file:../shared",
    "@supabase/supabase-js": "^2.86.2",
    "capacitor-secure-storage-plugin": "0.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "7.18.3",
    "socket.io-client": "^4.7.2",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "^1.40.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@typescript-eslint/eslint-plugin": "~8.39.0",
    "@typescript-eslint/parser": "~8.39.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "~6.4.3",
    "vitest": "~4.1.11"
  },
  "keywords": [
    "dinder",
    "dinner",
    "react",
    "vite"
  ],
  "author": "Dinder Team",
  "license": "MIT"
}
